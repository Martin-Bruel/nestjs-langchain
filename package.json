{
  "name": "nestjs-langchain",
  "version": "1.0.1",
  "type": "module",
  "description": "NestJS library to build agents with LangChain",
  "keywords": [
    "nestjs",
    "langchain",
    "agents",
    "ai"
  ],
  "author": "Martin Bruel",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rimraf -rf dist && tsc -p tsconfig.build.json",
    "format": "prettier --write \"{lib,tests}/**/*.ts\" vitest.config.ts",
    "lint": "oxlint --type-aware lib/ tests/ vitest.config.ts --fix",
    "lint:check": "oxlint --type-aware lib/ tests/ vitest.config.ts",
    "prepublish:npm": "npm run build",
    "publish:npm": "npm publish --access public",
    "prepublish:next": "npm run build",
    "publish:next": "npm publish --access public --tag next",
    "test": "vitest run",
    "test:watch": "vitest",
    "prerelease": "npm run build",
    "release": "release-it",
    "prepare": "husky",
    "test:cov": "vitest run --coverage",
    "format:check": "prettier --check \"{lib,tests}/**/*.ts\" vitest.config.ts"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "^20.4.1",
    "@langchain/core": "^1.1.18",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/common": "^11.1.18",
    "@nestjs/core": "^11.1.18",
    "@nestjs/schematics": "^12.0.1",
    "@nestjs/testing": "^11.1.18",
    "@types/express": "^5.0.6",
    "@types/lodash": "4.17.25",
    "@types/node": "^25.1.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "husky": "9.1.7",
    "joi": "18.2.9",
    "langchain": "^1.2.15",
    "lint-staged": "16.2.7",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.8.1",
    "reflect-metadata": "^0.2.2",
    "release-it": "19.2.4",
    "rimraf": "6.1.3",
    "rxjs": "^7.8.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@langchain/core": "^1.1.18",
    "@nestjs/common": "^11.1.18 || ^12.0.0",
    "@nestjs/core": "^11.1.18 || ^12.0.0",
    "langchain": "^1.2.15",
    "reflect-metadata": "^0.2.2"
  },
  "lint-staged": {
    "{lib,tests}/**/*.ts": [
      "oxlint --type-aware --fix",
      "prettier --write"
    ],
    "vitest.config.ts": [
      "oxlint --type-aware --fix",
      "prettier --write"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
