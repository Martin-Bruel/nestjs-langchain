{
  "name": "nestjs-langchain",
  "version": "2.0.0",
  "type": "module",
  "description": "Turn your NestJS app into an LLM harness, powered by LangChain: build AI agents as NestJS modules, with your providers as their tools.",
  "keywords": [
    "nestjs",
    "nest",
    "langchain",
    "ai",
    "agents",
    "ai-agents",
    "llm",
    "tools",
    "tool-calling",
    "function-calling",
    "openai",
    "anthropic",
    "zod",
    "decorators",
    "typescript"
  ],
  "author": "Martin Bruel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Martin-Bruel/nestjs-langchain.git"
  },
  "homepage": "https://github.com/Martin-Bruel/nestjs-langchain#readme",
  "bugs": {
    "url": "https://github.com/Martin-Bruel/nestjs-langchain/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "lib",
    "!lib/**/*.spec.ts",
    "README.md"
  ],
  "workspaces": [
    ".",
    "samples/*"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json -w",
    "format": "prettier --write \"{lib,tests,scripts}/**/*.{ts,mjs}\" vitest.config.ts",
    "lint": "oxlint --type-aware lib/ tests/ scripts/ vitest.config.ts --fix",
    "lint:check": "oxlint --type-aware lib/ tests/ scripts/ vitest.config.ts",
    "test": "vitest run --typecheck",
    "test:watch": "vitest",
    "release": "release-it",
    "release:rc": "release-it --preRelease=rc --no-plugins.@release-it/conventional-changelog.infile",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "test:cov": "vitest run --coverage",
    "format:check": "prettier --check \"{lib,tests,scripts}/**/*.{ts,mjs}\" vitest.config.ts",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:exports": "publint && attw --pack --ignore-rules cjs-resolves-to-esm"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "^21.2.3",
    "@langchain/core": "^1.2.3",
    "@langchain/openai": "^1.2.10",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/testing": "^12.0.1",
    "@release-it/conventional-changelog": "12.0.2",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint-plugin-jsdoc": "^65.2.0",
    "husky": "9.1.7",
    "langchain": "^1.5.4",
    "lint-staged": "16.4.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.8.1",
    "publint": "^0.3.24",
    "reflect-metadata": "^0.1.12 || ^0.2.0",
    "release-it": "21.1.1",
    "rimraf": "6.1.3",
    "rxjs": "^7.8.2",
    "semver": "^7.8.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@langchain/core": "^1.2.3",
    "@nestjs/common": "^11.1.18 || ^12.0.1",
    "@nestjs/core": "^11.1.18 || ^12.0.1",
    "langchain": "^1.5.4",
    "reflect-metadata": "^0.1.12 || ^0.2.0",
    "zod": "^4.0.0"
  },
  "lint-staged": {
    "{lib,tests,scripts}/**/*.{ts,mjs}": [
      "oxlint --type-aware --fix",
      "prettier --write"
    ],
    "vitest.config.ts": [
      "oxlint --type-aware --fix",
      "prettier --write"
    ]
  }
}
