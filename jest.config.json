{
  "displayName": "nestjs-langchain",
  "rootDir": ".",
  "testEnvironment": "node",
  "moduleFileExtensions": ["js", "json", "ts"],
  "testMatch": ["<rootDir>/lib/**/*.spec.ts", "<rootDir>/tests/**/*.spec.ts"],
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      { "tsconfig": "<rootDir>/tests/tsconfig.json" }
    ]
  }
}
