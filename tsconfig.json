{
  "compilerOptions": {
    "module": "nodenext",
    "declaration": true,
    "removeComments": false,
    "noLib": false,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "useUnknownInCatchVariables": false,
    "experimentalDecorators": true,
    "strict": true,
    "target": "ES2021",
    "sourceMap": false,
    "skipLibCheck": true,
    "outDir": "./dist",
    "types": [
      "vitest/globals",
      "node"
    ],
    "moduleResolution": "nodenext"
  },
  "include": [
    "lib/**/*",
    "tests/**/*",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
